{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyInventoryResolution",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ScopedParameterRead",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:*:parameter/lab07/*"
    }
  ]
}
