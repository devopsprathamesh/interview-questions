aws_region       = "us-east-1"
environment      = "production"
ami_id           = "REPLACE-WITH-CURRENT-AMAZON-LINUX-2023-AMI-ID"
instance_type    = "t3.small"
desired_capacity = 2
min_size         = 2
max_size         = 4
db_engine        = "postgres"
db_instance_class = "db.t3.small"
db_multi_az      = true # production: genuine within-region HA
